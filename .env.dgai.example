# dgai — production environment.
#
# Copy to .env.dgai on the server and replace every <placeholder>.
# The compose file refuses to start while any required value is missing.
#
# Generate secrets with:
#   openssl rand -hex 24     # passwords
#   openssl rand -hex 32     # session secret

# GHCR image built by .github/workflows/dgai-image.yml.
# The repository name must be lowercase (GHCR rejects uppercase).
DGAI_IMAGE_REPO=dungzg/dgai
DGAI_IMAGE_TAG=latest

# Domain served by Caddy. Must point at this server (A/AAAA record).
DGAI_SITE_ADDRESS=dgai.vn
DGAI_PUBLIC_URL=https://dgai.vn

DGAI_DB_PASSWORD=<random-24-bytes-hex>
DGAI_REDIS_PASSWORD=<random-24-bytes-hex>
DGAI_SESSION_SECRET=<random-32-bytes-hex>
