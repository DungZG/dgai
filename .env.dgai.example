# dgai — production environment.
#
# Copy to .env.dgai on the server and replace every <placeholder>.
# The compose file refuses to start while any required value is missing.
#
# Generate secrets with:
#   openssl rand -hex 24     # passwords
#   openssl rand -hex 32     # session secret
# Telegram bot from @BotFather -> API Token. Without it the bot stays disabled.
TELEGRAM_BOT_TOKEN=
# Telegram Login Widget credentials (BotFather -> Login Widget). The allowed
# redirect URL must be https://<domain>/oauth/telegram.
TELEGRAM_CLIENT_ID=
TELEGRAM_CLIENT_SECRET=
# Set to true to enable Telegram login. Leave blank to keep the console setting.
TELEGRAM_OAUTH_ENABLED=
# Optional Telegram support destination; set the numeric group ID (usually
# negative) after creating the group.
DGAI_TELEGRAM_SUPPORT_CHAT_ID=
DGAI_TELEGRAM_SUPPORT_URL=

# GHCR image built by .github/workflows/dgai-image.yml.
# The repository name must be lowercase (GHCR rejects uppercase).
DGAI_IMAGE_REPO=dungzg/dgai
DGAI_IMAGE_TAG=latest

# Domain served by Caddy. Must point at this server (A/AAAA record).
DGAI_SITE_ADDRESS=dgai.io.vn
DGAI_PUBLIC_URL=https://dgai.io.vn

DGAI_DB_PASSWORD=<random-24-bytes-hex>
DGAI_REDIS_PASSWORD=<random-24-bytes-hex>
DGAI_SESSION_SECRET=<random-32-bytes-hex>
