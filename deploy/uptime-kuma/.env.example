# Uptime Kuma settings. Everything here can be changed with ./uk.sh.
#
# UK_PORT is the only value that matters when the host comes back on a
# different port: change it, then ./uk.sh up.

# Published port on the host. Must be free, 1-65535.
UK_PORT=3001

# Port the provider publishes to the internet when it differs from UK_PORT
# (NAT hosts that hand out a new external port after a stop/start). Only the
# printed URL and the dgai iframe use it; leave empty to reuse UK_PORT.
UK_EXTERNAL_PORT=

# Bind address. 0.0.0.0 exposes the site; 127.0.0.1 keeps it local-only
# (useful while you reach it through an SSH tunnel).
UK_BIND=0.0.0.0

# Public host or IP shown in the URL printed by ./uk.sh url.
# Leave empty to detect the public IPv4 address on demand.
UK_HOST=

# Set this when the dashboard is reached through a stable name (reverse proxy,
# Cloudflare Tunnel, tailnet). When set, it wins over UK_HOST and UK_PORT in
# the printed URL, and the changing host port no longer affects the address.
UK_PUBLIC_URL=

# http or https. Use https only behind a TLS terminator.
UK_SCHEME=http

# Image tag and container name.
UK_VERSION=2
UK_NAME=uptime-kuma

TZ=Asia/Ho_Chi_Minh
UK_DISABLE_STATS=true
